NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Stripe Test Mode API Keys (from Stripe Dashboard -> Developers -> API keys)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Scheduled Risk Evaluation Cron Secret (protects /api/risk/evaluate endpoint)
CRON_SECRET=propedge_cron_secret_key_demo_12345

# Email Alerts (Optional - Resend free tier or Supabase Auth SMTP)
RESEND_API_KEY=re_...
ADMIN_EMAIL=admin@propedge.demo

